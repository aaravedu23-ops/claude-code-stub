# Copy to .env and fill in. Only DATABASE_URL and BETTER_AUTH_SECRET are required to run locally.

DATABASE_URL="file:./dev.db"

# Any long random string. Generate one with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (optional). Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (optional). Without a key, password reset codes and monthly reports are printed to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Stub <hello@yourdomain.com>"

# Receipt scanning with Claude (optional). Without a key, scanning falls back to on-device OCR.
ANTHROPIC_API_KEY=""
RECEIPT_MODEL="claude-opus-5-5"

# Protects the monthly report endpoint (/api/cron/monthly).
CRON_SECRET=""
